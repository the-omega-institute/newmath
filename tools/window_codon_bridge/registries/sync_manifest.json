{
  "fetch_branches": ["feat/bio-reality-deepening", "feat/fibonacci_reality-deepening"],
  "publish_branch": "feat/window-codon-bridge",
  "materialize": [
    {
      "branch": "feat/bio-reality-deepening",
      "src": "tools/bio_reality/registries/claims.json",
      "dest": "bio/registries/claims.json"
    },
    {
      "branch": "feat/bio-reality-deepening",
      "src": "tools/bio_reality/registries/experiments.json",
      "dest": "bio/registries/experiments.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src": "tools/fibonacci_reality/registries/claims.json",
      "dest": "fibonacci/registries/claims.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src": "tools/fibonacci_reality/registries/experiments.json",
      "dest": "fibonacci/registries/experiments.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src": "papers/fibonacci_reality/parts/forced_window_structure.tex",
      "dest": "fibonacci/forced_window_structure.tex"
    }
  ],
  "materialize_globs": [
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src_glob": "papers/fibonacci_reality/parts/namecerts/*.tex",
      "strip_prefix": "papers/fibonacci_reality/parts/namecerts",
      "dest_dir": "fibonacci/namecerts"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src_glob": "tools/fibonacci_reality/experiments/run_track_a_*.py",
      "strip_prefix": "tools/fibonacci_reality/experiments",
      "dest_dir": "fibonacci/experiments"
    }
  ],
  "materialize_inventories": [
    {
      "branch": "feat/bio-reality-deepening",
      "src_glob": "tools/bio_reality/experiments/*.py",
      "dest": "bio/experiment_inventory.json"
    },
    {
      "branch": "feat/bio-reality-deepening",
      "src_glob": "papers/bio_reality/parts/namecerts/*.tex",
      "dest": "bio/namecert_inventory.json"
    },
    {
      "branch": "feat/bio-reality-deepening",
      "src_glob": "tools/bio_reality/data/*.json",
      "dest": "bio/data_inventory.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src_glob": "tools/fibonacci_reality/experiments/*.py",
      "dest": "fibonacci/experiment_inventory.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src_glob": "tools/fibonacci_reality/experiments/run_b_star_q6_*.py",
      "dest": "fibonacci/b_star_q6_inventory.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src_glob": "papers/fibonacci_reality/parts/namecerts/*.tex",
      "dest": "fibonacci/namecert_inventory.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src_glob": "tools/fibonacci_reality/data/*.json",
      "dest": "fibonacci/data_inventory.json"
    },
    {
      "branch": "feat/fibonacci_reality-deepening",
      "src_glob": "papers/fibonacci_reality/parts/forced_window_structure/*.tex",
      "dest": "fibonacci/forced_window_structure_inventory.json"
    }
  ]
}
