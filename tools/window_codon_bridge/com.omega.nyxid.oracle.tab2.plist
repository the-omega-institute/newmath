  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/nyxid-omega-worker-tab2.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nyxid-omega-worker-tab2.launchd.log</string>
