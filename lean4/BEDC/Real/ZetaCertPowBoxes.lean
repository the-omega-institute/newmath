def lnBoxes : Array Dy.I :=
  powBoxes.map (fun p => p.ln)

def centerBoxes : Array CBox :=
  powBoxes.map (fun p => p.box)

def powBoxMList : List Nat :=
  powBoxes.toList.map (fun p => p.m)

def entryOk (i m : Nat) : Bool :=
  let p := powBoxes.getD i defaultPowBox
  decide (p.m = m) && Dy.ok p.ln && CBox.ok p.box

