import BEDC.Real.ZetaCertDy

set_option autoImplicit false
set_option maxHeartbeats 2000000

namespace BEDC
namespace ZetaCert

structure CBox where
  re : Dy.I
  im : Dy.I
deriving Repr, DecidableEq

namespace CBox

def zero : CBox :=
  { re := Dy.zero, im := Dy.zero }

def ok (z : CBox) : Bool :=
  Dy.ok z.re && Dy.ok z.im

def add (z w : CBox) : CBox :=
  { re := Dy.add z.re w.re, im := Dy.add z.im w.im }

def neg (z : CBox) : CBox :=
  { re := Dy.neg z.re, im := Dy.neg z.im }

def sub (z w : CBox) : CBox :=
  add z (neg w)

def smul (a : Dy.I) (z : CBox) : CBox :=
  { re := Dy.mul a z.re, im := Dy.mul a z.im }

def mul (z w : CBox) : CBox :=
  { re := Dy.sub (Dy.mul z.re w.re) (Dy.mul z.im w.im),
    im := Dy.add (Dy.mul z.re w.im) (Dy.mul z.im w.re) }

def eqb (z w : CBox) : Bool :=
  decide (z = w)

def subset (z w : CBox) : Bool :=
  Dy.subset z.re w.re && Dy.subset z.im w.im

end CBox

