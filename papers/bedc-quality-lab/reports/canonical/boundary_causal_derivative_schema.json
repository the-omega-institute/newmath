    "BoundarySpec": {
      "additionalProperties": false,
      "properties": {
        "boundary_id": {
          "type": "string"
        },
        "domain_pointer": {
          "type": "string"
        },
        "nonclaim_boundary_pointer": {
          "type": "string"
        },
        "scope_seal_pointer": {
          "type": "string"
        }
