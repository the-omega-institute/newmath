      "readiness_gate": "full_retraining_loss_ablation",
      "required_systems": [
        "full_s3",
        "minus_l_unlogged",
        "minus_l_gap",
        "minus_l_stab",
        "minus_l_intervention"
      ],
      "run_command": "python scripts/run_torch_retraining_loss_ablation.py",
